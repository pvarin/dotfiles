# ~/.gitconfig — shared settings. Your name/email live in ~/.gitconfig.local
# (created by install.sh, not committed to the repo).
[include]
	path = ~/.gitconfig.local

[init]
	defaultBranch = main
[core]
	editor = nvim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true        # n / N jump between files in a diff
	line-numbers = true
	side-by-side = false   # flip to true on wide screens
[diff]
	algorithm = histogram
	colorMoved = default
[merge]
	conflictstyle = zdiff3
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
[rebase]
	autoStash = true
[branch]
	sort = -committerdate

[alias]
	st = status -sb
	co = checkout
	sw = switch
	lg = log --graph --pretty=format:'%C(yellow)%h%Creset %C(blue)%ad%Creset %s%C(auto)%d %C(dim)%an' --date=short
	last = log -1 HEAD --stat
	undo = reset --soft HEAD~1
	wt = worktree

# ~/.ssh/config
# Machine-specific hosts go in ~/.ssh/config.local (not tracked). It's included first
# because ssh uses the first value it finds for each setting.
Include ~/.ssh/config.local

# Load the key into the agent on first use and keep its passphrase (if any) in the macOS
# Keychain, so git over SSH never prompts — including for agents running unattended.
Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519

# Ghostty config — see `ghostty +show-config --default --docs` for every option.
# Reload with Cmd+Shift+, (or restart Ghostty).

font-family = JetBrainsMono Nerd Font
font-size = 14
font-thicken = true

# Follows macOS light/dark mode. List available names with: ghostty +list-themes
theme = dark:Catppuccin Mocha,light:Catppuccin Latte

window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
macos-titlebar-style = tabs
window-save-state = always

# Let Option act as Alt so fzf's Alt-C and Neovim/tmux Meta bindings work.
macos-option-as-alt = true

copy-on-select = clipboard
mouse-hide-while-typing = true
confirm-close-surface = false
shell-integration-features = cursor,sudo,title

# Shift+Enter inserts a newline in Claude Code prompts instead of submitting.
keybind = shift+enter=text:\x1b\r

# Uncomment to drop straight into a persistent tmux session on launch:
# command = /opt/homebrew/bin/tmux new-session -A -s main

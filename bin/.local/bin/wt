#!/usr/bin/env bash
# wt — give an agent its own git worktree, in its own tmux window, running Claude.
#   wt <branch>          create (or reuse) worktree <repo>.worktrees/<branch> and open it
#   wt -l                list worktrees
#   wt -r <branch>       remove the worktree (the branch itself is kept)
# Worktrees live next to the repo: ~/code/app  ->  ~/code/app.worktrees/<branch>
set -euo pipefail

usage() { sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }

root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "wt: not inside a git repo" >&2; exit 1; }
# If we're already inside a worktree, anchor on the main checkout.
main="$(git -C "$root" worktree list --porcelain | awk '/^worktree /{print $2; exit}')"
repo="$(basename "$main")"
base="$(dirname "$main")/${repo}.worktrees"

case "${1:-}" in
  ""|-h|--help) usage ;;
  -l) git -C "$main" worktree list; exit 0 ;;
  -r)
    [[ -n "${2:-}" ]] || usage
    git -C "$main" worktree remove "$base/$2"
    echo "Removed worktree $base/$2 (branch '$2' kept; delete with: git branch -D $2)"
    exit 0 ;;
esac

branch="$1"
dir="$base/$branch"

if [[ ! -d "$dir" ]]; then
  mkdir -p "$base"
  if git -C "$main" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$main" worktree add "$dir" "$branch"
  else
    git -C "$main" worktree add -b "$branch" "$dir"
  fi
fi

if [[ -n "${TMUX:-}" ]]; then
  win="$(tmux new-window -P -F '#{window_id}' -n "$branch" -c "$dir")"
  tmux send-keys -t "$win" "claude" Enter
  echo "Opened tmux window '$branch' with Claude in $dir"
else
  echo "Worktree ready: $dir"
  echo "Tip: run inside tmux and wt opens a window with Claude for you."
fi
